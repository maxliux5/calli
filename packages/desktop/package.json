{
  "name": "@calli/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Calli's Mac app: a native shell around the hub's web UI (Electron).",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dist:mac": "node scripts/assemble-mac.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^45.2.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
