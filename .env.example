# Copy to .env and fill in. .env is git-ignored.

# Address the daemon listens on. Keep 127.0.0.1 for local use.
# For remote access over VPN, set this to the VPN interface address.
CALLI_HOST=127.0.0.1
CALLI_PORT=8787

# Static access token. Generate a long random value, e.g. `openssl rand -hex 32`.
CALLI_TOKEN=

# Where the SQLite database is stored. Relative paths resolve from the directory the daemon starts in.
CALLI_DATA_DIR=./data

# Agent executables. Claude: leave empty to use the bundled ACP adapter. pi, agy, traex, codex, dsh and doubao:
# leave empty to use the one on PATH. An agent that is not installed is simply shown as unavailable.
CALLI_CLAUDE_ACP_BIN=
# The claude CLI itself, for local one-shot runs (quota reads, signed-in account discovery).
CALLI_CLAUDE_BIN=
CALLI_PI_BIN=
CALLI_AGY_BIN=
CALLI_TRAEX_BIN=
CALLI_CODEX_BIN=
# DeepSeek Harness; the ACP profile it serves is `dsh --profile acp`.
CALLI_DSH_BIN=
# Doubao CLI; uses its public -p / --resume interface.
CALLI_DOUBAO_BIN=
# Experimental streaming: enable native JSON events in an isolated runtime copy (2.31.2, Linux x64).
# Leaves the installed CLI/config/session files unchanged; empty keeps final-text print mode.
CALLI_DOUBAO_STREAM=
# Only for custom launchers: absolute path to the native runtime directory containing manifest.json.
CALLI_DOUBAO_RUNTIME=

# Working directories offered in the UI, comma-separated. Empty means the daemon's start directory.
CALLI_WORKDIRS=/path/to/project-a,/path/to/project-b

# Shell that runs in a web terminal. Empty means $SHELL, then /bin/bash.
CALLI_TERM_SHELL=

# Private Unix socket used by this node's relay client. Keep it enabled when joining a hub.
# Empty means ~/.local/state/calli/daemon.sock; `off` disables it.
CALLI_SOCKET=
# Join settings generated on the hub: leave empty for a standalone machine.
CALLI_HUB_URL=
CALLI_HUB_TOKEN=

# Your own browser on this machine, shown on the VNC desktop; agents drive it with agent-browser.
# Profile (holds your sign-ins). Empty means browser/profile under the data directory.
CALLI_BROWSER_PROFILE=
# X display to show it on. Empty follows the VNC desktop; `off` turns the browser off.
CALLI_BROWSER_DISPLAY=
# Chrome to start. Empty prefers Google Chrome, then Chromium.
CALLI_BROWSER_EXECUTABLE=
# agent-browser, when it is not on PATH (npm install -g agent-browser).
CALLI_AGENT_BROWSER=

# Built web UI to serve at `/`. Leave empty to use packages/web/dist when it exists.
CALLI_WEB_DIR=

# Used only by `npm run dev:web` (Vite dev server) to find the daemon.
CALLI_DAEMON_URL=http://127.0.0.1:8787
